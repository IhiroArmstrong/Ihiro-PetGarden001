# Dependencies & build
node_modules/
focus-tiger/src/locales/localeSliceModules.js
dist/
.vite/
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local toolchains (not part of the app)
.tools/
*.pkg

# Env / secrets
.env
.env.*
!.env.example

# Confide sealed blind holdout (R-0). Originals stay out of git.
focus-tiger/.secrets/confide-blind-holdout/*
!focus-tiger/.secrets/confide-blind-holdout/README.md

# Logs & caches
*.log
npm-debug.log*
.cache/
focus-tiger/.tmp/

# Electron desktop pack output (Step A)
focus-tiger/desktop/release/
*.jsc

# Desktop companion L0 probe artifacts (GGUF is never committed)
focus-tiger/desktop/.l0-cache/
focus-tiger/desktop/.spike-17b-cache/
focus-tiger/desktop/companion/reports/
*.gguf

# Test / coverage artifacts
coverage/
playwright-report/
test-results/
focus-tiger/.playwright-browsers/

# Large local art sources (keep on disk; do not push)
focus-tiger/art-reference/models/sources/*
!focus-tiger/art-reference/models/sources/README.md

# Ingested sprite / video source archives — frames live under public/sprites/
*-transparent.zip
*_transparent_bg.zip
*_transparent.zip
*transparent*.zip

# Local scratch notes at repo root (authoritative text belongs under focus-tiger/docs/)
/*.rtf
# Mood-veto zh devset SSOT is focus-tiger/fixtures/ — never a second copy at repo root
/confide-mood-veto-devset-zh-v1.json

# Worktree session occupancy lock (Agent; never commit)
.ft-session-lock
.ft-session-identity

# Cursor Agent hook runtime session state (per-chat; never commit)
.cursor/hooks/state/

# Art-collection masters are not part of the public repo.
focus-tiger/private/art-collection-hd/
