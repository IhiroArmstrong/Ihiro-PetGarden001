    "locale:import-ja": "node scripts/locale-pack.js import-ja",
    "i18n:sync": "node scripts/i18n-sync.js",
    "confide:dump-observation": "node scripts/dump-confide-observation.js",
    "audit:practice-coverage": "node scripts/audit-practice-coverage.js",
    "audit:practice-coverage:sync": "node scripts/audit-practice-coverage.js --write",
    "audit:growth-metrics": "node scripts/audit-growth-metrics.js",
    "audit:growth-metrics:sync": "node scripts/audit-growth-metrics.js --write",
    "audit:local-backup-coverage": "node scripts/audit-local-backup-coverage.js",
    "audit:read-hybrid-gapfill": "node scripts/audit-read-hybrid-gapfill.js",
    "audit:confide-semantic-shadow": "node scripts/audit-confide-semantic-shadow.js",
    "audit:stage2b-po-seeded-gate": "node scripts/audit-confide-stage2b-po-seeded.js",
    "audit:stage2b-lab-seeded-gate": "node scripts/audit-confide-stage2b-po-seeded.js",
    "audit:confide-prior-asymmetric": "node scripts/audit-confide-prior-asymmetric.js",
    "audit:confide-kb-matrix-probes": "node scripts/audit-confide-kb-matrix-probes.js",
    "audit:confide-acceptance-leak": "node scripts/audit-confide-acceptance-devset-leak.js",
    "audit:confide-safety-devset": "node scripts/audit-confide-safety-devset.js",
