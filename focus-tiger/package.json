{
  "name": "focus-tiger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "test:smoke": "node --test src/core/scenario-smoke.test.js src/core/localStateKeys.test.js src/core/SessionUiGate.test.js src/ui/focusHudHalo.test.js src/ui/focusHudLive.test.js src/ui/sharedSittingProgress.test.js src/core/PracticeDaysStore.test.js src/ui/WeeklyPracticeHeatmap.test.js src/core/onboardingHintRegistry.test.js src/core/OnboardingHintsStore.test.js src/ui/hintDiscoveryDots.test.js src/core/sessionUiGateContractRegistry.test.js src/core/visibilityContractRegistry.test.js src/ui/outsideDismissGuard.test.js && npm run docs:check",
    "docs:check": "node scripts/docs-check.js",
    "hints:doc-check": "node scripts/hints-doc-check.js",
    "hints:doc-sync": "node scripts/hints-doc-check.js --write",
    "gate:doc-check": "node scripts/gate-contract-doc-check.js",
    "gate:doc-sync": "node scripts/gate-contract-doc-check.js --write",
    "visibility:doc-check": "node scripts/visibility-contract-doc-check.js",
    "visibility:doc-sync": "node scripts/visibility-contract-doc-check.js --write",
    "state:doc-check": "node scripts/state-machine-doc-check.js",
    "state:doc-sync": "node scripts/state-machine-doc-check.js --write",
    "rules:doc-check": "node scripts/rules-authority-doc-check.js",
    "rules:doc-sync": "node scripts/rules-authority-doc-check.js --write",
    "test:e2e": "playwright test",
    "test:e2e:visibility": "node scripts/run-visibility-e2e.js",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "^6.3.5"
  }
}
