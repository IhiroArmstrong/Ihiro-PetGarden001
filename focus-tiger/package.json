    "audit:fit-product-minus-mood-margin": "node desktop/scripts/l0-fit-product-minus-mood-margin.js",
    "audit:routing-arbitration-shadow": "node desktop/scripts/l0-routing-arbitration-shadow-lab.js",
    "audit:routing-arbitration-ab": "node desktop/scripts/l0-routing-arbitration-ab-lab.js",
