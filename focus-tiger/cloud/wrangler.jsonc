/**
 * Focus Tiger · Cloudflare Workers (API + Tip Jar + Sanctuary Lifetime)
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * KV (separate bindings — never share tip/sanctuary records):
 *   npx wrangler kv namespace create TIP_KV
 *   npx wrangler kv namespace create SANCTUARY_KV
 *
 * Secrets (never commit):
 *   npx wrangler secret put STRIPE_SECRET_KEY
 *   npx wrangler secret put STRIPE_WEBHOOK_SECRET
 *
 * Prices (Dashboard one-time):
 *   Tip → STRIPE_PRICE_ID
 *   Sanctuary Lifetime → STRIPE_SANCTUARY_PRICE_ID
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "focus-tiger-cloud",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-21",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "TIP_KV",
			"id": "32a307c4623f4d78a4bfd66da34b8849",
			"preview_id": "0bc78a51324f4d189a657ad16ed03dd9"
		},
		{
			"binding": "SANCTUARY_KV",
			"id": "aed8165fd9a8452b9e0edff38298c498",
			"preview_id": "4c16cddae489432f9b3a76126a077717"
		}
	],
	"vars": {
		"STRIPE_PRICE_ID": "price_1U22ujFuIhgJPGLiGp2gTPMM",
		"CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&tip=1",
		"CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&tip=cancel",
		"STRIPE_SANCTUARY_PRICE_ID": "price_1U22T4FuIhgJPGLiT0hcEWxY",
		"SANCTUARY_CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&sanctuary_session={CHECKOUT_SESSION_ID}",
		"SANCTUARY_CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&sanctuary=cancel",
		"ALLOWED_ORIGIN": "http://127.0.0.1:5173"
	}
}
