/**
 * Focus Tiger · Cloudflare Workers (API + Tip Jar + Sanctuary Lifetime + Membership)
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * KV (separate bindings — never share tip/sanctuary/membership records):
 *   npx wrangler kv namespace create TIP_KV
 *   npx wrangler kv namespace create SANCTUARY_KV
 *   npx wrangler kv namespace create MEMBERSHIP_KV
 *   npx wrangler kv namespace create OTP_KV
 *   npx wrangler kv namespace create OTP_KV --preview
 *   npx wrangler kv namespace create PRACTICE_BACKUP_KV
 *   npx wrangler kv namespace create PRACTICE_BACKUP_KV --preview
 *   npx wrangler kv namespace create NEWSLETTER_KV
 *   npx wrangler kv namespace create NEWSLETTER_KV --preview
 *
 * Secrets (never commit):
 *   npx wrangler secret put STRIPE_SECRET_KEY
 *   npx wrangler secret put STRIPE_WEBHOOK_SECRET
 *   npx wrangler secret put RESEND_API_KEY
 *   npx wrangler secret put RESTORE_OTP_PEPPER
 *
 * Prices (Dashboard):
 *   Tip → STRIPE_PRICE_ID (one-time)
 *   Sanctuary Lifetime → STRIPE_SANCTUARY_PRICE_ID (one-time)
 *   Yin Membership / Focus Tiger Base → STRIPE_MEMBERSHIP_PRICE_ID (recurring)
 *   Focus Tiger Pro → STRIPE_PRO_PRICE_ID (recurring; Price price_1U6EB1FuIhgJPGLiuciuX1to; reserved — no checkout route yet)
 *   Lifetime AI add-on → STRIPE_COMPANION_ADDON_PRICE_ID (one-time; SKU companion.addon.lifetime; Price price_1U6GnXFuIhgJPGLiNlXs0IKe; reserved — no checkout)
 *
 * MEMBERSHIP_KV (created 2026-08-10):
 *   id         = 331994910f30411393e241c1252d85e6
 *   preview_id = 5496acb38b20430b936e700e598d3c6a
 *
 * OTP_KV (created 2026-08-11):
 *   id         = 7d5acbe48de44cefac2bc041809c1f27
 *   preview_id = d0211c3d14e44798b41833c06e6d0f27
 *
 * NEWSLETTER_KV (created 2026-08-13):
 *   id         = baeb661cb8f2450ab4a87d6f23af6896
 *   preview_id = 8e13fe05705841c9939c3164bfb9a3bd
 *
 * Production Worker (2026-08-20): Version 5b5b3451-4c35-4d9b-b27b-622b72ed673e
 * Covers taste-layer schemaVersion 1 freeze tables (plus 2026-08-16 Tip $4.99 / newsletter).
 * Tip STRIPE_PRICE_ID = price_1U4nanFuIhgJPGLidoTdxobW (US$4.99).
 * Still includes newsletter routes + welcome await/retry (covers 8c649d12 / d0140328).
 * Funnel layout ingest whitelist (#378, origin/develop tip 8535da1) is IN SOURCE
 * but NOT in this live Version — Redeploy on Mac (163 / ihiro) still required.
 * Cloud Agent 2026-08-20: user said 部署; no CLOUDFLARE_API_TOKEN; do not --temporary.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "focus-tiger-cloud",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-21",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "TIP_KV",
			"id": "e26fc50b134e4eaeb59a3f4a551f3415",
			"preview_id": "b9543c7cef3b4e68a4e96cf0a8811375"
		},
		{
			"binding": "SANCTUARY_KV",
			"id": "d337b4b132e147d193e8e6ec03e12b9a",
			"preview_id": "d71d6fed42a249a5a749b3ae5f268857"
		},
		{
			"binding": "MEMBERSHIP_KV",
			"id": "331994910f30411393e241c1252d85e6",
			"preview_id": "5496acb38b20430b936e700e598d3c6a"
		},
		{
			"binding": "OTP_KV",
			"id": "7d5acbe48de44cefac2bc041809c1f27",
			"preview_id": "d0211c3d14e44798b41833c06e6d0f27"
		},
		{
			"binding": "PRACTICE_BACKUP_KV",
			"id": "f6f99774f3274f9f9e57c5f985a6b0b4",
			"preview_id": "5b9051e902a240b19f050291f6de75ca"
		},
		{
			"binding": "NEWSLETTER_KV",
			"id": "baeb661cb8f2450ab4a87d6f23af6896",
			"preview_id": "8e13fe05705841c9939c3164bfb9a3bd"
		}
	],
	"vars": {
		// Tip / Buy Yin a Tea one-time Price (US$4.99; below Membership $6.99/mo).
		"STRIPE_PRICE_ID": "price_1U4nanFuIhgJPGLidoTdxobW",
		"CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&tip=1",
		"CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&tip=cancel",
		"STRIPE_SANCTUARY_PRICE_ID": "price_1U22T4FuIhgJPGLiT0hcEWxY",
		"SANCTUARY_CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&sanctuary_session={CHECKOUT_SESSION_ID}",
		"SANCTUARY_CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&sanctuary=cancel",
		"STRIPE_MEMBERSHIP_PRICE_ID": "price_1U2r5lFuIhgJPGLiEPOhJbst",
		"MEMBERSHIP_CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&membership_session={CHECKOUT_SESSION_ID}",
		"MEMBERSHIP_CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&membership=cancel",
		"MEMBERSHIP_PORTAL_RETURN_URL": "http://127.0.0.1:5173/?product=1",
		"STRIPE_PRO_PRICE_ID": "price_1U6EB1FuIhgJPGLiuciuX1to",
		"PRO_CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&pro_session={CHECKOUT_SESSION_ID}",
		"PRO_CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&pro=cancel",
		"STRIPE_COMPANION_ADDON_PRICE_ID": "price_1U6GnXFuIhgJPGLiNlXs0IKe",
		"COMPANION_ADDON_CHECKOUT_SUCCESS_URL": "http://127.0.0.1:5173/?product=1&companion_addon_session={CHECKOUT_SESSION_ID}",
		"COMPANION_ADDON_CHECKOUT_CANCEL_URL": "http://127.0.0.1:5173/?product=1&companion_addon=cancel",
		"ALLOWED_ORIGIN": "http://127.0.0.1:5173",
		"RESEND_FROM": "Yin <restore@twinsology.com>",
		"NEWSLETTER_FROM": "Yin <hello@twinsology.com>"
	}
}
